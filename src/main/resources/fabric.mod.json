{
  "schemaVersion": 1,
  "id": "tooltipeta",
  "version": "${version}",
  "name": "TooltipETA",
  "description": "Displays durability estimates in item tooltips and Loyalty trident return ETA in the actionbar.",
  "authors": ["kvxd"],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/tooltipeta/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.kvxd.tooltipeta.TooltipETAClient"
    ],
    "modmenu": [
      "org.kvxd.tooltipeta.TooltipETAModMenuIntegration"
    ]
  },
  "mixins": [
    "tooltipeta.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
